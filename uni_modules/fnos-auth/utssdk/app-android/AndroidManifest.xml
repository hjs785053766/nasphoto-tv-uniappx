<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NAS 在局域网内，走 HTTP/WS（默认 5666）或 HTTPS/WSS（默认 5667） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 电视盒子/电视通常没有触摸屏，声明为非必需，避免应用商店按触摸屏过滤 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      重要：targetSdk >= 28 时 Android 默认禁止明文 HTTP。
      飞牛默认的 5666 端口就是纯 HTTP，不开这个开关会直接抛
      "Cleartext HTTP traffic to ... not permitted"。
    -->
    <application android:usesCleartextTraffic="true" />

    <!--
      说明：这里只做「权限 + 明文 HTTP + 无触摸屏」这类安全合并。
      Android TV（Leanback）启动器所需的 LEANBACK_LAUNCHER intent-filter
      需要加到 Activity 上，请参考项目根目录 nativeResources/android/AndroidManifest.xml。
    -->
</manifest>
